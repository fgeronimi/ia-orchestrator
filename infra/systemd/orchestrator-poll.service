# Poller GitHub : détecte les issues taggées ai-ready et les notifie.
# Déclenché par orchestrator-poll.timer (oneshot).
# Installation :  make install-timer
# Logs :          journalctl -u orchestrator-poll -f

[Unit]
Description=Orchestrateur IA - poller GitHub (issues ai-ready)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fgeronimi
WorkingDirectory=/home/fgeronimi/ia-orchestrator
EnvironmentFile=/home/fgeronimi/ia-orchestrator/.env
# node en dur (nvm absent du contexte systemd) : l'exécutant appelle `claude`.
# Ajuster si la version de Node change (ls ~/.nvm/versions/node/).
Environment=PATH=/home/fgeronimi/.nvm/versions/node/v20.20.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/fgeronimi/ia-orchestrator/infra/poll.sh

PrivateTmp=true
