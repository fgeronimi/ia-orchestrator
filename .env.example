# Copier vers .env et remplir. Ne JAMAIS commiter .env.
# chmod 600 .env

# --- Bot Discord ---
DISCORD_BOT_TOKEN=
# Canal où le bot poste les notifications (clic droit sur le canal → Copier l'ID,
# nécessite le mode développeur Discord)
NOTIFY_CHANNEL_ID=

# --- Notifications hors bot (optionnel, pour les timers systemd) ---
# Webhook du canal notifs : réglages canal → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=

# --- Claude Code ---
# Généré via `claude setup-token` sur le Mac
CLAUDE_CODE_OAUTH_TOKEN=

# --- Pipeline dev GitHub ---
# PAT fine-grained scopé sur chaque repo de data/repos.yaml.
# Contents=write       push des branches ai/* (lib/workspace)
# Pull requests=write  ouvrir / commenter les PR
# Issues=write         labels ai-*, commentaires, tickets de la forge
# Actions=read         état des jobs de CI (vert/rouge) et leurs logs
#                      (Checks n'existe pas pour un PAT fine-grained)
# Administration=read  rulesets (forge)
# Metadata=read        imposé par GitHub
# Optionnel : Workflows=write, sinon tout push qui touche .github/workflows/
# est refusé. Expiration surveillée par le timer santé (préavis J-7 / J-1).
GITHUB_TOKEN=
# Repo surveillé — secours si data/repos.yaml est absent
WATCHED_REPO=

# --- Surveillance machine (optionnel) ---
# Seuil d'alerte disque en %, borné à [50, 99]. Défaut 80.
# Escalades automatiques à 90% et 95%.
SEUIL_DISQUE=
