# Copier vers .env et remplir. Ne JAMAIS commiter .env.
# chmod 600 .env

# --- Bot Discord ---
DISCORD_BOT_TOKEN=
# Canal où le bot poste les notifications (clic droit sur le canal → Copier l'ID,
# nécessite le mode développeur Discord)
NOTIFY_CHANNEL_ID=

# --- Notifications hors bot (optionnel, pour les timers systemd) ---
# Webhook du canal notifs : réglages canal → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=

# --- Claude Code ---
# Généré via `claude setup-token` sur le Mac
CLAUDE_CODE_OAUTH_TOKEN=

# --- Pipeline dev GitHub ---
# PAT fine-grained scopé au(x) repo(s) surveillé(s).
# Phase 0 (lecture) : permissions Issues=read, Metadata=read.
GITHUB_TOKEN=
# Repo surveillé par défaut (owner/nom) si non passé en argument à poll.py
WATCHED_REPO=fgeronimi/ia-orchestrator

# --- Jira (pipeline dev, étape suivante) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
