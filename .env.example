# Copier vers .env et remplir. Ne JAMAIS commiter .env.
# chmod 600 .env

# --- Bot Discord ---
DISCORD_BOT_TOKEN=
# Canal où le bot poste les notifications (clic droit sur le canal → Copier l'ID,
# nécessite le mode développeur Discord)
NOTIFY_CHANNEL_ID=

# --- Notifications hors bot (optionnel, pour les timers systemd) ---
# Webhook du canal notifs : réglages canal → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=

# --- Claude Code ---
# Généré via `claude setup-token` sur le Mac
CLAUDE_CODE_OAUTH_TOKEN=

# --- Pipeline dev GitHub ---
# PAT fine-grained scopé au(x) repo(s) surveillé(s).
# Phase 0 (poller, lecture)  : Issues=read, Metadata=read.
# Phase 1 (exécutant, écrit) : Contents=write, Pull requests=write, Issues=write.
# Forge (data/forge.yaml)   : Administration=read (rulesets).
GITHUB_TOKEN=
# Repo surveillé — secours si data/repos.yaml est absent
WATCHED_REPO=

# --- Surveillance machine (optionnel) ---
# Seuil d'alerte disque en %, borné à [50, 99]. Défaut 80.
# Escalades automatiques à 90% et 95%.
SEUIL_DISQUE=
